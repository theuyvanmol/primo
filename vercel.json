{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/kongdashboard",
      "destination": "https://kongdashboard.vercel.app/",
      "permanent": false
    },
    {
      "source": "/kongdashboard/:path*",
      "destination": "https://kongdashboard.vercel.app/:path*",
      "permanent": false
    }
  ]
}
